{
  "name": "@tomcog/case-study",
  "version": "0.3.0",
  "description": "Case study (mini project) builder and immersive player for React apps",
  "type": "module",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "dev": "vite",
    "build:app": "vite build",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p app/tsconfig.json",
    "prepare": "npm run build"
  },
  "dependencies": {
    "lucide-react": "^1.0.1"
  },
  "peerDependencies": {
    "motion": ">=11",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@tomcoggia/ui": "github:tomcog/component-library#v0.86.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "motion": "12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.3.5"
  },
  "allowScripts": {
    "github:tomcog/component-library#6c1fcdd9d36233838a3569d59ef815dafb1d9348": true
  }
}
